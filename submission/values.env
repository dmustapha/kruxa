# Values the coordinator and the owner fill before running scripts/fill-submission.sh.
# One KEY=value per line, no quotes needed. Every key below must be non-empty or the script refuses.
# The repo goes public: do NOT put TEAM_EMAIL in this file. Leave it blank here and run
#   TEAM_EMAIL=you@example.com scripts/fill-submission.sh
# (the script reads the environment first). Leave no key out.
#
# Not here, because the script derives them: git head (git rev-parse), hashes and sizes (artifacts/SHA256SUMS),
# judge and fast-run steps and wall time (evidence/judge-run.txt, evidence/judge-fast-run.txt),
# core build commit (artifacts/BUILD-KIND), explorer URL (from CORE_ACCOUNT).

# Final testnet account names (coordinator).
CORE_ACCOUNT=
MARKET_ACCOUNT=
LAUNCHER_ACCOUNT=

# URLs the owner creates (links are checked by hand: open each one logged out).
REPO_URL=
X_POST_URL=
VIDEO_URL=

# Owner-only fields. PAYOUT_ACCOUNT is the owner's own NEAR account; an agent never picks it.
PAYOUT_ACCOUNT=
TEAM_LEAD=
TEAM_EMAIL=
TEAM_SIZE=

# Must equal one track in submission/track-claims.json "claimed", spelled exactly.
PREFERRED_TRACK=

# Git tag pushed with main (the plan, OUTSTANDING-2026-11-14.md item SP9, names it hackathon-submission).
RELEASE_TAG=
