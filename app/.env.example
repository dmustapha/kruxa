# Every NEXT_PUBLIC_* key the app reads. Testnet defaults. lib/env-example.test.ts fails if a key is read in code and missing here.
# Mainnet is refused unless NEXT_PUBLIC_MAINNET_CONFIRMED is set to the exact confirmation token below,
# which only Dami sets, per action. No other token or mint may exist on mainnet before the brand token.

# --- network ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Wallet layer environment: testnet or mainnet. Mainnet signing also needs the confirmation token.
NEXT_PUBLIC_KRUXA_ENV=testnet
NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.near.org
# NEXT_PUBLIC_MAINNET_CONFIRMED=DAMI-PER-ACTION-CONFIRMED
# Explorer prefix for NEAR transactions in the market views.
NEXT_PUBLIC_EXPLORER_TX=https://testnet.nearblocks.io/txns/

# --- contracts ---
# These defaults are undeployed placeholders. The live testnet stack is in .env.testnet (npm run dev:testnet).
# Mainnet has NO defaults: set every account below explicitly, or the app refuses to start (R_MAINNET_ACCOUNTS).
NEXT_PUBLIC_CORE_ACCOUNT=core.kruxa.testnet
NEXT_PUBLIC_USDC_ACCOUNT=usdc.kruxa.testnet
# The Intents token id of USDC that the core accepts.
NEXT_PUBLIC_USDC_TOKEN_ID=nep141:usdc.kruxa.testnet
NEXT_PUBLIC_INTENTS_ACCOUNT=intents.kruxa.testnet
NEXT_PUBLIC_FACTORY_ACCOUNT=factory.kruxa.testnet
NEXT_PUBLIC_MARKET_ACCOUNT=market.kruxa.testnet
NEXT_PUBLIC_INSTANT_ACCOUNT=instant.kruxa.testnet
# Kill switch for Instant launches in Create: set to 0 to show the disabled card.
NEXT_PUBLIC_INSTANT_MODE=1

# --- services ---
# Indexer read API (docs/interfaces/api.openapi.yaml). Also the base printed in /llms.txt and /AGENTS.md.
NEXT_PUBLIC_KRUXA_API=http://localhost:8787
# Optional relayer that submits buyer-signed Intents messages. Empty: the app shows the signed bundle for self-submission.
NEXT_PUBLIC_RELAYER_URL=
# Public address of this site, used for share cards (Open Graph). Empty: relative links only.
NEXT_PUBLIC_SITE_URL=

# Snapshot fallback: bake the feed, launch pages and token pages with
#   node services/api/src/snapshot.ts <db> <network> app/public/snapshot [core,..] [market,..]
# and deploy app/public/snapshot with the site. When this API is unreachable the app serves it, labelled RECORDED.

# --- site notices ---
# A maintenance message turns the status strip amber. The contracts, not the site, still decide every action.
NEXT_PUBLIC_MAINTENANCE=

# --- demo profile (labelled demo account, same wasm with relaxed bounds). Empty: not configured in this build. ---
NEXT_PUBLIC_DEMO_CORE_ACCOUNT=
# Seeded demo launches, for example A:1,B:2,C:3
NEXT_PUBLIC_DEMO_LAUNCHES=
