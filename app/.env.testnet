# Live NEAR TESTNET stack (play money). Public account ids only, no secrets. Load with: npm run dev:testnet  (or build:testnet).
# Next does not read .env.testnet by itself; the scripts source it into the shell (node --env-file breaks inside Next, which re-spawns with NODE_OPTIONS). Mainnet stays refused (R_MAINNET_GATE).
# Sources: evidence/indexer-testnet/README.md (core3, market3), evidence/instant-testnet/run3/accounts.json (launcher), evidence/instant-testnet/run2/accounts.json (usdc),
# evidence/testnet-core3/deploy.json (intents). core4.kxi-root-1108.testnet is the newer core; swap NEXT_PUBLIC_CORE_ACCOUNT to use it.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_KRUXA_ENV=testnet
NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.near.org
NEXT_PUBLIC_EXPLORER_TX=https://testnet.nearblocks.io/txns/

# core3 is the account the committed snapshot and compare files were ingested from.
NEXT_PUBLIC_CORE_ACCOUNT=core3.kxi-root-1108.testnet
NEXT_PUBLIC_MARKET_ACCOUNT=market3.kxi-root-1108.testnet
NEXT_PUBLIC_USDC_ACCOUNT=usdc.kxi-root-1108.testnet
NEXT_PUBLIC_USDC_TOKEN_ID=nep141:usdc.kxi-root-1108.testnet
NEXT_PUBLIC_INTENTS_ACCOUNT=intents.kxa1-owner-1203.testnet
# Instant launcher from the run3 testnet run (current artifact 90b87782, real factory token.primitives.testnet). Run2 (demo-instant.kxi-root-1108, wasm cb9646ad) stays as historical evidence.
# The run3 launcher settles in its own mock USDC usdc.kxi-root-1111.testnet (not the core USDC above): instant-mode calls in the app need that token id.
NEXT_PUBLIC_INSTANT_ACCOUNT=demo-instant.kxi-root-1111.testnet
NEXT_PUBLIC_FACTORY_ACCOUNT=factory.kxi-root-0811.testnet
NEXT_PUBLIC_INSTANT_MODE=1

# Indexer read API. Replace with the hosted URL once one exists (hosting is not done). With no indexer the app serves its baked snapshot, labelled RECORDED.
NEXT_PUBLIC_KRUXA_API=http://127.0.0.1:8787
# Optional remote snapshot (GitHub Pages) of the API pages, absolute https URL, no trailing slash. Used when no live API is configured or it fails.
NEXT_PUBLIC_SNAPSHOT_BASE_URL=
NEXT_PUBLIC_RELAYER_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_MAINTENANCE=
NEXT_PUBLIC_DEMO_CORE_ACCOUNT=
NEXT_PUBLIC_DEMO_LAUNCHES=
