{
  "name": "kruxa-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --turbopack",
    "dev:testnet": "sh -c 'set -a; . ./.env.testnet; set +a; exec next dev --turbopack'",
    "build:testnet": "sh -c 'set -a; . ./.env.testnet; set +a; exec next build'",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "node scripts/sync-evidence.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@noble/hashes": "2.2.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "lightweight-charts": "5.2.1",
    "near-api-js": "7.4.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
