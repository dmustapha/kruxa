# Copy to ~/.kruxa-secrets/mainnet/values.env (outside the repo) and edit. `set -a; . ~/.kruxa-secrets/mainnet/values.env; set +a` before running the scripts.
# NO KEY MATERIAL IN THIS FILE. Keys live in files OUTSIDE the repo, mode 600, named per run in KRUXA_KEY_FILE.
# A line marked CITED has repo evidence. A line marked OWNER TO CONFIRM is a placeholder: the scripts refuse REPLACE_ME.

# ---- network ------------------------------------------------------------------------------------------------------------------------
KRUXA_NEAR_RPC=https://rpc.mainnet.near.org        # CITED: docs/INVARIANTS.md read-only probes used this endpoint. Scripts also check chain_id == mainnet.
KRUXA_SOL_RPC=https://api.mainnet-beta.solana.com  # CITED: docs/PRD.md A7 (public, rate limited; a paid RPC is better for the Squads step)
KRUXA_SOL_MAINNET_GENESIS_HASH=REPLACE_ME          # OWNER TO CONFIRM: Solana mainnet-beta genesis hash. NOT in repo evidence (only the devnet hash is). Take it from solana.com docs and run `solana genesis-hash --url mainnet-beta` to cross-check.

# ---- external contracts -------------------------------------------------------------------------------------------------------------
KRUXA_USDC=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1   # CITED: docs/PRD.md A4 and docs/INVARIANTS.md (native USDC, 6 decimals)
KRUXA_INTENTS=intents.near                          # CITED: docs/INVARIANTS.md SOURCE LOCK (code hash BtA1BEFNS619KkvXFsgcpQ21Tb5yMm32aaUkn7xNothk)
KRUXA_SIGNER_CONTRACT=v1.signer                     # CITED: docs/PRD.md A6, version 3.17.0, domain 1 Ed25519
KRUXA_FACTORY=REPLACE_ME                            # OWNER TO CONFIRM: PRD A5 names token.primitives.near; X-4 leaves tkn.primitives.near open. Cost and refund UNPROVEN on mainnet (O-9). Run account-plan.mjs first.

# ---- accounts (the .near names are the owner's choice; none is in repo evidence) --------------------------------------------------------
KRUXA_OWNER=REPLACE_ME                              # OWNER TO CONFIRM: the account that signs owner calls and the trial. dimez.near exists (ledger F-34) but is not ruled as the owner.
KRUXA_GUARDIAN=REPLACE_ME                           # suggested: guardian.<owner>
KRUXA_TREASURY=REPLACE_ME                           # suggested: treasury.<owner>
KRUXA_RELAY_FEES=REPLACE_ME                         # suggested: relay-fees.<owner>
KRUXA_GENESIS_RELAYER=REPLACE_ME                    # suggested: genesis-relayer.<owner>; holds a function-call key limited to the relayer methods
KRUXA_CORE=REPLACE_ME                               # suggested: core.<owner>   (PRD says core.kruxa.near; only valid if the owner controls kruxa.near)
KRUXA_MARKET=REPLACE_ME                             # suggested: market.<owner>
KRUXA_PAYOUT=REPLACE_ME                             # OWNER TO CONFIRM (DN-9): NEAR account that receives the creator stream and the USDC payout

# ---- Genesis plan for create_trial ----------------------------------------------------------------------------------------------------
KRUXA_GENESIS_MODE=F0                               # F0 primary, F1 fallback (ruling R-F0F1). The mainnet Solana genesis driver does not exist yet: see the runbook, BLOCKERS.
KRUXA_F0_MINT_PUBKEY_HEX=REPLACE_ME                 # from scripts/mainnet/f0-key-mainnet.ts, only for F0, only after the core is deployed
KRUXA_F0_LAUNCH_ID=1                                # the launch id that key was derived for (the first launch on a fresh core is 1)
KRUXA_METADATA_URI=REPLACE_ME                       # OWNER TO CONFIRM: final public URL of the token metadata JSON; only its sha256 goes on chain
KRUXA_SQUADS_MULTISIG=REPLACE_ME                    # printed by create-squads-vault.mjs after step M2

# ---- Squads vault (M2) -----------------------------------------------------------------------------------------------------------------
KRUXA_SQUADS_MEMBERS=REPLACE_ME                     # OWNER TO CONFIRM: three PUBLIC keys, comma separated (Phantom, Solflare, Backpack), no spaces

# ---- per run (set on the command line, never saved here) -----------------------------------------------------------------------------------
# KRUXA_KEY_FILE=~/.kruxa-secrets/mainnet/<account>.json   the signer of THIS transaction (ed25519 private_key, mode 600, outside the repo)
# KRUXA_SOL_KEY_FILE=~/.kruxa-secrets/mainnet/sol-feepayer.json   the Solana fee payer for M2
# KRUXA_NEW_KEY_FILE=~/.kruxa-secrets/mainnet/<new account>.json  where create-account.mjs writes a new account's key
# KRUXA_MAINNET_CONFIRMED=I_CONFIRM_DAMI_RUNS_THIS         ONLY when the owner has said "go" in chat for exactly this action
