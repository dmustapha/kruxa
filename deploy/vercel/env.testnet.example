# Paste these into Vercel: Project, Settings, Environment Variables, scope Production (and Preview). All values are PUBLIC (NEXT_PUBLIC_*), no secrets.
# Vercel does not read app/.env.testnet. These values are copied from it so the hosted build matches the testnet stack.
# They are baked into the bundle at build time: changing one needs a redeploy.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_KRUXA_ENV=testnet
NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.near.org
NEXT_PUBLIC_EXPLORER_TX=https://testnet.nearblocks.io/txns/

NEXT_PUBLIC_CORE_ACCOUNT=core3.kxi-root-1108.testnet
NEXT_PUBLIC_MARKET_ACCOUNT=market3.kxi-root-1108.testnet
NEXT_PUBLIC_USDC_ACCOUNT=usdc.kxi-root-1108.testnet
NEXT_PUBLIC_USDC_TOKEN_ID=nep141:usdc.kxi-root-1108.testnet
NEXT_PUBLIC_INTENTS_ACCOUNT=intents.kxa1-owner-1203.testnet
NEXT_PUBLIC_INSTANT_ACCOUNT=demo-instant.kxi-root-1111.testnet
NEXT_PUBLIC_FACTORY_ACCOUNT=factory.kxi-root-0811.testnet
# 1 shows Instant launches in Create, 0 shows the disabled card (kill switch). Needs a redeploy to change.
NEXT_PUBLIC_INSTANT_MODE=1

# The Oracle API, https, no trailing slash. Placeholder: replace with the real domain. Also printed in /llms.txt and /AGENTS.md.
NEXT_PUBLIC_KRUXA_API=https://api.kruxa.example
# Free path (no backend): the GitHub Pages base of the snapshot workflow, https, no trailing slash, for example https://<user>.github.io/<repo>.
# With this set and NEXT_PUBLIC_KRUXA_API left EMPTY (delete the line above), the app reads the snapshot only. See docs/runbooks/hosting.md.
NEXT_PUBLIC_SNAPSHOT_BASE_URL=
# The site's own public address (share cards). Placeholder: replace with the Vercel or custom domain.
NEXT_PUBLIC_SITE_URL=https://kruxa.example
# Empty means no relayer: the app shows the signed bundle for self-submission.
NEXT_PUBLIC_RELAYER_URL=
# Non-empty turns the status strip amber with that message.
NEXT_PUBLIC_MAINTENANCE=
NEXT_PUBLIC_DEMO_CORE_ACCOUNT=
NEXT_PUBLIC_DEMO_LAUNCHES=
