# Copy to .env (same directory as docker-compose.yml). No secrets here.
# Public hostname of the API. Create the DNS A record for it first. Placeholder:
API_DOMAIN=api.kruxa.example
# Email Let's Encrypt may contact about certificate expiry.
ACME_EMAIL=owner@example.com
# Host folder for the SQLite file, snapshot and backups (bootstrap.sh creates it owned by uid 1000, the image's node user).
KRUXA_DATA_HOST=/srv/kruxa/data
# Host folder for the keeper and watcher key files (mounted read-only at /secrets). Keep it mode 700; it holds keys, so it is never in git.
KRUXA_SECRETS_HOST=/srv/kruxa/secrets
