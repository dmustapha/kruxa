# Copy to indexer.env. Public contract account ids only. The indexer is read-only: it holds no key and needs none.
# Values below match app/.env.testnet. Mainnet is not configured here and must not be, until the owner rules it.
KRUXA_NETWORK=testnet
KRUXA_CORE=core3.kxi-root-1108.testnet
KRUXA_MARKET=market3.kxi-root-1108.testnet
# Instant launcher account (matches NEXT_PUBLIC_INSTANT_ACCOUNT in app/.env.testnet). Optional.
KRUXA_LAUNCHER=demo-instant.kxi-root-1111.testnet
# Used only when the database is empty: "tip" or a block height. A fresh DB loses history before this height,
# so restore a backup (backup.sh) instead of starting empty when history matters.
KRUXA_START_HEIGHT=tip
# Optional NEAR JSON-RPC used as a block-scan fallback when neardata.xyz errors. Public endpoint, no key.
KRUXA_RPC_URL=https://rpc.testnet.near.org
# Health says "stale" when the indexer trails the chain head by more than this many blocks.
KRUXA_MAX_LAG=120
# Vesting day length in seconds. Leave 86400 unless the launcher demo profile needs 10.
KRUXA_INSTANT_DAY_SECONDS=86400
