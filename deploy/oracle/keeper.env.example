# Copy to keeper.env. NO secrets in this file: the key lives in a file under KRUXA_SECRETS_HOST, mounted read-only at /secrets.
# Testnet only. The daemon refuses a non-.testnet account, core or RPC.
KEEPER_CORE=core3.kxi-root-1108.testnet
KEEPER_ACCOUNT_ID=keeper.kxi-root-1108.testnet
# A near-api-js or near-cli credentials JSON file (account id plus the account key). Mounted read-only, never baked into the image.
KEEPER_KEY_FILE=/secrets/keeper.json
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Dry-run is the default: it prints what it would send. Set to 1 only when you want it to sign and send.
KEEPER_SEND=0
KEEPER_INTERVAL_MS=30000
KEEPER_MIN_CALL_INTERVAL_MS=250
KEEPER_SOLVENCY_EVERY_MS=600000
KEEPER_STUCK_AFTER_MS=900000
KEEPER_ALERT_REPEAT_MS=3600000
# Optional: a webhook that receives one JSON POST per alert (Slack, Discord relay, ntfy). Leave empty for log-only alerts.
ALERT_WEBHOOK_URL=
