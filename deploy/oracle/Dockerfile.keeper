# Kruxa keeper daemon (services/keeper). Build from the repo root context (compose does this).
# Dry-run by default: it only sends transactions when KEEPER_SEND=1 is set in keeper.env.
FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app/services/keeper
COPY services/keeper/package.json services/keeper/package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY services/keeper/src ./src
USER node
CMD ["npx", "tsx", "src/cli.ts"]
