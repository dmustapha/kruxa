# Copy to watcher.env. NO secrets in this file: keys are files under KRUXA_SECRETS_HOST, mounted read-only at /secrets.
# Devnet/testnet only. The daemon refuses a non-.testnet core.
WATCHER_CORE=core3.kxi-root-1108.testnet
WATCHER_CLUSTER=devnet
NEAR_TESTNET_RPC=https://test.rpc.fastnear.com
# The relayer's NEAR account (must be the core's genesis_relayer) and the Solana devnet funder.
KRUXA_NEAR_KEY=/secrets/near-testnet-f0.json
KRUXA_RELAYER_KEY=/secrets/relayer-devnet.json
# Dry-run is the default: it reports what it would run. Set to 1 only when you want it to sign and send.
WATCHER_SEND=0
WATCHER_RECORD_DIR=/data/genesis-records
WATCHER_INTERVAL_MS=30000
WATCHER_MAX_ATTEMPTS=3
# Take every Passed launch (1), or only those with a Solana plan (default), or name ids: WATCHER_ONLY_LAUNCHES=3,4
WATCHER_ALL=0
WATCHER_ONLY_LAUNCHES=
# Abort a stranded F1 genesis on chain automatically (1). Default 0: alert only.
WATCHER_AUTO_ABORT_F1=0
# {id} is replaced by the launch id. The default is the rehearsal placeholder; set the real metadata URL.
WATCHER_METADATA_URI_TEMPLATE=https://kruxa.example/rehearsal/{id}.json
ALERT_WEBHOOK_URL=
